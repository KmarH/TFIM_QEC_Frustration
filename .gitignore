# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data / figures: keep the directories (via .gitkeep) but ignore bulky outputs.
# Validation text reports are small and intentionally tracked.
data/*.npy
data/*.npz
data/*.h5
data/*.hdf5
figures/*.png
figures/*.pdf
figures/*.svg

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Conversation history — kept separate from the project; not part of the codebase
Conversation history/

# Local review/scratch dirs (never project content)
review-rc/

# Second environment for the H2 local emulator (requirements-le.txt)
.venv-le/
# Nexus submission ledger holds job ids/costs from real runs
runs/

# Team report (Spanish): shared as a PDF, not kept in the repository
docs/report/reporte_tecnico.*
